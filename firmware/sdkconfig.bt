# Added to sdkconfig.defaults for the Pac-Man face only: a Bluetooth LE game controller (lib/core/Gamepad.cpp).
# NimBLE host in the central role, one connection, LE only (the classic Bluetooth memory is handed back).
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=n
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
CONFIG_BTDM_CTRL_MODE_BR_EDR_ONLY=n
CONFIG_BTDM_CTRL_MODE_BTDM=n
CONFIG_BT_NIMBLE_ROLE_CENTRAL=y
CONFIG_BT_NIMBLE_ROLE_OBSERVER=y
CONFIG_BT_NIMBLE_ROLE_PERIPHERAL=n
CONFIG_BT_NIMBLE_ROLE_BROADCASTER=n
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BT_NIMBLE_NVS_PERSIST=y
CONFIG_BT_NIMBLE_SECURITY_ENABLE=y
CONFIG_BT_NIMBLE_SM_LEGACY=y
CONFIG_BT_NIMBLE_SM_SC=y
CONFIG_BT_NIMBLE_GAP_SERVICE=n
CONFIG_BT_NIMBLE_HOST_TASK_STACK_SIZE=5120
CONFIG_BT_NIMBLE_LOG_LEVEL_NONE=y
CONFIG_BT_LOG_CRITICAL_ONLY=y
# Trimmed buffers: one connection, a handful of reports, a small scan list (every kilobyte here is missing from the heap)
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BTDM_SCAN_DUPL_CACHE_SIZE=20
CONFIG_BT_NIMBLE_MAX_BONDS=2
CONFIG_BT_NIMBLE_MAX_CCCDS=2
CONFIG_BT_NIMBLE_GATT_MAX_PROCS=3
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=6
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=6
CONFIG_BT_NIMBLE_HCI_EVT_HI_BUF_COUNT=4
CONFIG_BT_NIMBLE_HCI_EVT_LO_BUF_COUNT=4
